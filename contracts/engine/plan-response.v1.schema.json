    "SourceForecast": {
      "additionalProperties": false,
      "properties": {
        "analogues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Analogue"
          },
          "title": "Analogues",
          "type": "array"
        },
        "censoredDays": {
          "title": "Censoreddays",
          "type": "integer"
        },
        "channel": {
          "enum": [
            "store",
            "online"
          ],
          "title": "Channel",
          "type": "string"
        },
        "demandClass": {
          "enum": [
            "smooth",
            "erratic",
            "intermittent",
            "lumpy",
            "zero",
            "new"
          ],
          "title": "Demandclass",
          "type": "string"
        },
        "locationId": {
          "title": "Locationid",
          "type": "string"
        },
        "meanOverPeriod": {
          "title": "Meanoverperiod",
          "type": "number"
        },
        "model": {
          "enum": [
            "seasonal_ma",
            "sba",
            "top_down",
            "zero",
            "analogue",
            "short_history_mean"
          ],
          "title": "Model",
          "type": "string"
        },
        "observedDays": {
          "title": "Observeddays",
          "type": "integer"
        },
        "promoUplift": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promouplift"
        },
        "shareOfItemDemand": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shareofitemdemand"
        },
        "varianceOverPeriod": {
          "title": "Varianceoverperiod",
          "type": "number"
        },
        "yearlySeasonality": {
          "default": false,
          "title": "Yearlyseasonality",
          "type": "boolean"
        }
