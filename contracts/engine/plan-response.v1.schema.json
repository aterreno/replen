      "required": [
        "locationId",
        "channel",
        "model",
        "demandClass",
        "meanOverPeriod",
        "varianceOverPeriod",
        "observedDays",
        "censoredDays"
      ],
      "title": "SourceForecast",
      "type": "object"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "default": {},
          "title": "Inputs",
          "type": "object"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "unit"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accuracy": {
      "$ref": "#/$defs/RunAccuracy"
    },
    "asOfDate": {
      "format": "date",
      "title": "Asofdate",
      "type": "string"
    },
    "contractVersion": {
      "default": "1.0.0",
      "title": "Contractversion",
      "type": "string"
    },
    "engineVersion": {
      "title": "Engineversion",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/OrderResult"
      },
      "title": "Orders",
      "type": "array"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "timingsMs": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timingsms",
      "type": "object"
    }
  },
  "required": [
    "engineVersion",
    "runId",
    "asOfDate",
    "items",
    "orders",
    "accuracy",
    "timingsMs"
  ],
  "title": "PlanResponse",
  "type": "object"
}
