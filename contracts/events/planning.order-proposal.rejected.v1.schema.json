  "title": "replen.planning.order-proposal.rejected.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid"
    },
    "rejectedBy": {
      "type": "string",
      "minLength": 1
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "proposalId",
    "rejectedBy",
    "reasonCode",
    "comment"
  ]
}
