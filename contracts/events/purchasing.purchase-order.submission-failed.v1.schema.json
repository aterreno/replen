{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.replen.local/events/purchasing.purchase-order.submission-failed.v1.schema.json",
  "title": "replen.purchasing.purchase-order.submission-failed.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "poId": {
      "type": "string",
      "format": "uuid"
    },
    "poNumber": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "poId",
    "poNumber",
    "attempt",
    "error",
    "retryable"
  ]
}
